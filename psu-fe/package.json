{
  "name": "psu-fe",
  "private": true,
  "version": "0.1.3",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run license:check && npm run license:policy",
    "build": "node scripts/quiet-build.mjs",
    "preview": "vite preview",
    "pretest": "npm run license:check && npm run license:policy",
    "test": "vitest run",
    "license:check": "license-check-and-add check -f .license-conf/license-check-and-add-config.json",
    "license:add": "license-check-and-add add -f .license-conf/license-check-and-add-config.json",
    "license:policy": "node scripts/quiet-license-policy.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/language": "^6.11.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "tailwindcss": "^4.1.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@lizenz/checker": "^0.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "license-check-and-add": "^4.0.5",
    "vite": "^6.0.5",
    "vitest": "^4.1.5"
  }
}
